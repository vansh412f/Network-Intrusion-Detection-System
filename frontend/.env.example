# Copy to frontend/.env and fill in your values.
# These are baked into the browser bundle at build time — not secret.

# Your backend URL (local: http://localhost:3000, production: your Render URL)
VITE_API_URL=http://localhost:3000

# Your sensor URL on Render (wakes up free-tier instance on page load)
# Leave blank for local development
VITE_SENSOR_URL=https://your-nids-sensor.onrender.com