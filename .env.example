# ═══════════════════════════════════════════════════════════════════════════════
#  NIDS SOC — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Two env files are used:
#
#    .env       → Development (docker-compose.yml & local dev)
#    .env.prod  → Production  (docker-compose.prod.yml)
#
#  Copy this template to create either file and fill in your values.
#  Never commit .env or .env.prod to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nids_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# ─── Sensor Auth ──────────────────────────────────────────────────────────────
SENSOR_SECRET=replace-with-a-shared-secret-between-sensor-and-backend

# ─── CORS Allowed Origins ────────────────────────────────────────────────────
#  Dev:  CLIENT_URL_DEV=http://localhost:5173
#  Prod: CLIENT_URL_DEV=https://your-production-domain.com
CLIENT_URL_DEV=http://localhost:5173
CLIENT_URL_PROD=https://your-production-domain.com

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
#  Dev:  NODE_ENV=development
#  Prod: NODE_ENV=production
NODE_ENV=development

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-specific-password
EMAIL_FROM="NIDS SOC <your-email@gmail.com>"

# ─── Sensor (real mode only — not needed in Docker simulate mode) ─────────────
INTERFACE=your-network-interface-name
MY_IP=your-local-ip

# ─── Backend URL (sensor → backend communication) ────────────────────────────
#  Local dev (no Docker):  BACKEND_URL=http://localhost:3000
#  Docker (dev or prod):   BACKEND_URL=http://backend:3000
#
#  NOTE: In docker-compose.yml the sensor's BACKEND_URL is overridden via
#  the `environment:` key, so .env can keep localhost:3000 for local dev.
BACKEND_URL=http://localhost:3000

# ─── Frontend (build-time only — Vite) ────────────────────────────────────────
# When using Nginx proxy in Docker (recommended), leave these empty.
# The Nginx container handles routing so the browser only talks to one origin.
# Only set these if deploying frontend standalone without the Nginx proxy.
VITE_API_URL=
VITE_SENSOR_URL=